generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum Singleton {
  ID
}

model Profile {
  // Use an enum with a single value to enforce a single table row
  id Singleton @id @default(ID)

  name        String
  description String
  links       Json // an array of strings
  skills      Skill[]
  experience  Experience[]
}

model Skill {
  id        Int       @id @default(autoincrement())
  profileId Singleton
  owner     Profile   @relation(fields: [profileId], references: [id])
  name      String

  @@unique([profileId, name])
}

model Experience {
  id           Int       @id @default(autoincrement())
  profileId    Singleton
  owner        Profile   @relation(fields: [profileId], references: [id])
  company      String
  position     String
  startedAt    DateTime
  endedAt      DateTime?
  achievements String

  @@unique([profileId, company])
}
